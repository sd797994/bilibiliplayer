<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:BiliBiliPlayer.Services"
             x:Class="BiliBiliPlayer.Views.PlayerPage"
             BackgroundColor="#08090C"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="64,*">
        <Grid Grid.Row="0"
              Padding="18,10"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              BackgroundColor="#111318"
              ZIndex="80">
            <Button Text="←"
                    Clicked="OnCloseClicked"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="0"
                    FontSize="20"
                    BackgroundColor="#23262E"
                    TextColor="#F2F3F5"
                    CornerRadius="12" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="1"
                                 VerticalOptions="Center">
                <Label x:Name="TitleLabel"
                       TextColor="#F2F3F5"
                       FontSize="15"
                       FontAttributes="Bold"
                       MaxLines="1"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="MetaLabel"
                       TextColor="#777D89"
                       FontSize="10"
                       MaxLines="1"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="8"
                                   VerticalOptions="Center">
                <Button x:Name="OpenWebButton"
                        Text="打开到网页"
                        Clicked="OnOpenWebClicked"
                        WidthRequest="96"
                        HeightRequest="36"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="#20232B"
                        TextColor="#EDEFF3"
                        BorderColor="#30343E"
                        BorderWidth="1"
                        CornerRadius="10" />
                <Button x:Name="DanmakuButton"
                        Text="弹幕"
                        Clicked="OnDanmakuClicked"
                        WidthRequest="72"
                        HeightRequest="36"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="#20232B"
                        TextColor="#FB7299"
                        BorderColor="#30343E"
                        BorderWidth="1"
                        CornerRadius="10" />
                <Button x:Name="ShareButton"
                        Text="分享"
                        Clicked="OnShareClicked"
                        WidthRequest="72"
                        HeightRequest="36"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="#20232B"
                        TextColor="#EDEFF3"
                        BorderColor="#30343E"
                        BorderWidth="1"
                        CornerRadius="10" />
                <Button x:Name="QualityMenuButton"
                        Text="自动  ▾"
                        Clicked="OnQualityMenuClicked"
                        WidthRequest="92"
                        HeightRequest="36"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="#20232B"
                        TextColor="#EDEFF3"
                        BorderColor="#30343E"
                        BorderWidth="1"
                        CornerRadius="10" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1">
            <!-- App-owned local player only. No Bilibili page is shown to the user. -->
            <WebView x:Name="PlayerWebView"
                     Loaded="OnPlayerWebViewLoaded"
                     Navigated="OnPlayerNavigated"
                     BackgroundColor="#08090C" />

            <!-- Lightweight host only. A resolver WebView2 is created here on demand,
                 removed immediately after playurl data has been captured, and does not stay
                 alive during normal playback. -->
            <Grid x:Name="ResolverHost"
                  WidthRequest="1"
                  HeightRequest="1"
                  Opacity="0.01"
                  InputTransparent="True"
                  HorizontalOptions="Start"
                  VerticalOptions="Start"
                  IsClippedToBounds="True"
                  ZIndex="-1" />

            <Grid x:Name="PlayerLoadingOverlay"
                  BackgroundColor="#B308090C"
                  InputTransparent="False"
                  ZIndex="30">
                <Border Padding="22,16"
                        BackgroundColor="#E615171D"
                        Stroke="#292D36"
                        StrokeThickness="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center">
                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsRunning="True"
                                           Color="#FB7299"
                                           WidthRequest="26"
                                           HeightRequest="26" />
                        <Label x:Name="LoadingLabel"
                               Text="正在初始化播放器…"
                               TextColor="#C4C7CF"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               MaxLines="3" />
                        <Button x:Name="RetryButton"
                                Text="重试"
                                Clicked="OnRetryClicked"
                                IsVisible="False"
                                BackgroundColor="#FB7299"
                                TextColor="White"
                                CornerRadius="9"
                                Padding="18,7" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- Custom quality menu. This replaces the native Windows Picker, which looked out of place. -->
        <Border x:Name="QualityMenu"
                Grid.RowSpan="2"
                IsVisible="False"
                WidthRequest="126"
                Margin="0,56,18,0"
                Padding="6"
                HorizontalOptions="End"
                VerticalOptions="Start"
                BackgroundColor="#F21A1D23"
                Stroke="#333741"
                StrokeThickness="1"
                ZIndex="120">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Button x:Name="Quality1080Button"
                        Text="1080P"
                        CommandParameter="80"
                        Clicked="OnQualityOptionClicked"
                        HeightRequest="34"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="Transparent"
                        TextColor="#EDEFF3"
                        CornerRadius="8" />
                <Button x:Name="Quality720Button"
                        Text="720P"
                        CommandParameter="64"
                        Clicked="OnQualityOptionClicked"
                        HeightRequest="34"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="Transparent"
                        TextColor="#EDEFF3"
                        CornerRadius="8" />
                <Button x:Name="Quality480Button"
                        Text="480P"
                        CommandParameter="32"
                        Clicked="OnQualityOptionClicked"
                        HeightRequest="34"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="Transparent"
                        TextColor="#EDEFF3"
                        CornerRadius="8" />
                <Button x:Name="Quality360Button"
                        Text="360P"
                        CommandParameter="16"
                        Clicked="OnQualityOptionClicked"
                        HeightRequest="34"
                        Padding="10,0"
                        FontSize="12"
                        BackgroundColor="Transparent"
                        TextColor="#EDEFF3"
                        CornerRadius="8" />
            </VerticalStackLayout>
        </Border>

        <Grid x:Name="ShareOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              ZIndex="140">
            <BoxView Color="#B308090C">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShareOverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border MaximumWidthRequest="440"
                    MaximumHeightRequest="780"
                    Padding="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="#F21A1D23"
                    Stroke="#333741"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="分享到微信"
                                   TextColor="#F2F3F5"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="发送标题、UP/播放量、封面和原始链接"
                                   TextColor="#8A909C"
                                   FontSize="11" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="×"
                                Clicked="OnShareOverlayTapped"
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0"
                                FontSize="18"
                                BackgroundColor="#23262E"
                                TextColor="#EDEFF3"
                                CornerRadius="10"
                                VerticalOptions="Start" />
                    </Grid>

                    <Border x:Name="ShareCard"
                            BackgroundColor="#23262E"
                            Stroke="#3A3F4A"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,*">
                            <Grid HeightRequest="132">
                                <Image x:Name="ShareCoverImage"
                                       Aspect="AspectFill"
                                       BackgroundColor="#1A1C22" />
                                <BoxView HeightRequest="34"
                                         Color="#99000000"
                                         VerticalOptions="End" />
                                <Grid Padding="10,0"
                                      HeightRequest="34"
                                      ColumnDefinitions="Auto,*,Auto"
                                      VerticalOptions="End">
                                    <Label Text="哔哩哔哩"
                                           TextColor="#FB7299"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           VerticalTextAlignment="Center" />
                                    <Label x:Name="ShareDurationLabel"
                                           Grid.Column="2"
                                           TextColor="#F1F2F5"
                                           FontSize="11"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="12,10,12,12"
                                                 Spacing="6">
                                <Label x:Name="ShareTitleLabel"
                                       TextColor="#F2F3F5"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                 <Label x:Name="ShareMetaLabel"
                                        TextColor="#8A909C"
                                        FontSize="11"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <Label Text="最近联系人"
                               TextColor="#EDEFF3"
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                        <Label x:Name="ShareContactsStatusLabel"
                               Grid.Column="1"
                               Text="未读取"
                               TextColor="#8A909C"
                               FontSize="11"
                               VerticalTextAlignment="Center" />
                        <Button x:Name="RefreshShareContactsButton"
                                Grid.Column="2"
                                Text="刷新"
                                Clicked="OnRefreshShareContactsClicked"
                                HeightRequest="30"
                                Padding="10,0"
                                FontSize="11"
                                BackgroundColor="#2B2F38"
                                TextColor="#DDE0E6"
                                CornerRadius="8" />
                    </Grid>

                    <CollectionView x:Name="ShareContactsView"
                                    HeightRequest="168"
                                    SelectionMode="Single"
                                    SelectionChanged="OnShareContactSelectionChanged"
                                    VerticalScrollBarVisibility="Always">
                        <CollectionView.EmptyView>
                            <Grid HeightRequest="168">
                                <Label Text="暂无可选联系人"
                                       TextColor="#717783"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Grid>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:WeChatShareContact">
                                <Border Margin="0,0,0,5"
                                        Padding="9,7"
                                        BackgroundColor="#23262E"
                                        Stroke="#333741"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#3A2732" />
                                                    <Setter Property="Stroke" Value="#FB7299" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid ColumnDefinitions="36,*,Auto"
                                          ColumnSpacing="10">
                                        <Border WidthRequest="36"
                                                HeightRequest="36"
                                                BackgroundColor="#343943"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Grid>
                                                <Label Text="{Binding AvatarText}"
                                                       TextColor="#DDE0E6"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Image Source="{Binding AvatarUrl}"
                                                       Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               TextColor="#F2F3F5"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalTextAlignment="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding KindText}"
                                               TextColor="#8A909C"
                                               FontSize="10"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label x:Name="ShareHintLabel"
                           Text="请选择接收卡片的联系人或群聊。"
                           TextColor="#9AA0AC"
                           FontSize="11"
                           LineBreakMode="WordWrap" />

                    <Border BackgroundColor="#23262E"
                            Stroke="#3A3F4A"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="RecommendationEntry"
                               Placeholder="推荐语（可选），将在卡片成功后发送"
                               PlaceholderColor="#717783"
                               TextColor="#F2F3F5"
                               BackgroundColor="Transparent"
                               FontSize="12"
                               HeightRequest="38"
                               MaxLength="500"
                               ReturnType="Done"
                               ClearButtonVisibility="WhileEditing" />
                    </Border>

                    <Button x:Name="ShareToWeChatButton"
                            Text="发送给所选联系人"
                            Clicked="OnShareToWeChatClicked"
                            IsEnabled="False"
                            HeightRequest="40"
                            FontSize="13"
                            BackgroundColor="#FB7299"
                            TextColor="White"
                            CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
